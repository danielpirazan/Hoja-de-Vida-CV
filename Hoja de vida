            <option value="Otro">Otro</option>
          </select>

          <label for="mensaje">Mensaje</label>
          <textarea id="mensaje" name="mensaje" rows="5" placeholder="Escribe tu mensaje..." required></textarea>
          <span class="error" id="error-mensaje"></span>

          <button type="submit" class="boton boton-primario">Enviar mensaje</button>
        </form>
      </div>
    </section>
  </main>

  <footer class="pie">
    <p>&copy; <span id="anio">2026</span> Daniel Esteban Pirazan Velasquez</p>
  </footer>

  <script src="js/main.js"></script>
